{
  "name": "streamflix-pro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev . --d1=DB",
    "deploy": "wrangler pages deploy . --project-name=streamflix-pro",
    "db:create": "wrangler d1 create streamflix_db",
    "db:migrate:local": "wrangler d1 execute streamflix_db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute streamflix_db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
